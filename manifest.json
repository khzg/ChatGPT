{
  "manifest_version": 3,
  "name": "AI Chat Everywhere",
  "version": "21.0.0",
  "description": "A privacy-friendly AI workspace with a local conversation manager, YouTube-to-Gemini prompts, smart selection actions, AI directory and web research. No AI API keys or extension registration required.",
  "icons": {
    "32": "icon-32.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "AI Chat Everywhere",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "AI Chat Everywhere",
    "default_panel": "sidebar.html",
    "default_icon": "icon.png",
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "menus",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "commands": {
    "open-ai-hub": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the AI Everywhere sidebar"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0",
      "id": "{4b19ef43-3087-4697-be91-bbb4cc733b7e}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
